# Supabase Auth (publishable key aman untuk browser) — Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL publik aplikasi (dipakai canonical URL, sitemap & robots). Produksi: https://pajangin.web.id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth: biarkan false sampai provider Google aktif di Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
