# Supabase Auth (publishable key aman untuk browser) — Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL publik aplikasi (dipakai canonical URL, sitemap & robots). Produksi: https://pajangin-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketing analytics (opsional). Kosongkan untuk menonaktifkan.
# GA4: Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity: Project settings → Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Search Console URL-prefix → verifikasi HTML tag → isi hanya nilai content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Untuk QA analytics di localhost. Jangan diaktifkan di production.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Login memakai Google OAuth. Aktifkan provider Google di Supabase Auth.
