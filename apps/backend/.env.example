# Supabase Postgres — runtime pakai transaction pooler (6543), migrasi pakai session pooler (5432)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth — dipakai untuk verifikasi access token (JWKS publik, tanpa secret)
SUPABASE_URL="https://<project-ref>.supabase.co"

# Hanya backend. Wajib untuk hapus akun mandiri (Admin API + pembersihan Storage).
# Jangan pernah memakai prefix NEXT_PUBLIC_ atau mengirimnya ke browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Origin frontend yang diizinkan CORS (pisahkan dengan koma jika lebih dari satu). Produksi: https://pajangin.web.id
FRONTEND_URL="http://localhost:3000"

# Email founder yang boleh membuka /admin (pisahkan dengan koma). Kosong = admin ditutup.
ADMIN_EMAILS=""

# Notifikasi WhatsApp untuk lead/booking. Dapatkan token dari dashboard Fonnte.
FONNTE_TOKEN=""

# Minimal satu provider AI untuk fitur generate konten. Boleh isi keduanya.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Batas harian opsional. Default: 20 generate AI dan 20 notifikasi WA per bisnis.
AI_DAILY_LIMIT=20
WA_DAILY_LIMIT=20

PORT=3001
