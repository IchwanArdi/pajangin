# Supabase Auth (publishable key aman untuk browser) — Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL publik aplikasi (dipakai canonical URL, sitemap & robots). Produksi: https://pajangin-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login memakai Google OAuth. Aktifkan provider Google di Supabase Auth.
