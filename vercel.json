{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "apps/backend",
      "framework": "nestjs",
      "installCommand": "pnpm install --frozen-lockfile --config.minimum-release-age=0",
      "buildCommand": "pnpm build",
      "entrypoint": "src/main.ts",
      "outputDirectory": "."
    },
    "frontend": {
      "root": "apps/frontend",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile --config.minimum-release-age=0",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
